#!/usr/bin/env python3
"""
Patch: 4 critical features for sim + monitor
1. Cross-chain dedup (shared_bought.json)
2. Consecutive SL counter (3 SLs → freeze 2h)
3. soldRatio monitoring (API check before buy)
4. Breakeven at +5% (TIME_TIERS first entry)
"""
import os, py_compile, shutil

SIM = os.path.expanduser("~/.qclaw/workspace/scripts/simulation/sm_monitor_sim.py")
MON = os.path.expanduser("~/.qclaw/workspace/scripts/active/realtime_sm_monitor.py")

def read_file(path):
    with open(path, 'r', encoding='utf-8-sig') as f:
        return f.read()

def write_file(path, content):
    with open(path, 'w', encoding='utf-8-sig') as f:
        f.write(content)

def backup(path):
    bak = path + '.pre_feature_patch'
    if not os.path.exists(bak):
        shutil.copy2(path, bak)
        print(f'  backed up: {bak}')

# ================================================================
# FEATURE 1: Shared cross-chain dedup
# ================================================================
SHARED_DEDUP_CONST = """
SHARED_DEDUP_FILE = os.path.join(DATA, 'shared_bought.json')
SHARED_DEDUP_TTL = 3600  # 1 hour dedup window
"""

SHARED_DEDUP_FUNCS = '''
def _load_shared_dedup():
    """Load shared cross-chain dedup file."""
    try:
        if os.path.exists(SHARED_DEDUP_FILE):
            with open(SHARED_DEDUP_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
    except:
        pass
    return {}

def _save_shared_dedup(data):
    """Save shared cross-chain dedup file."""
    try:
        with open(SHARED_DEDUP_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f)
    except:
        pass

def _check_shared_dedup(ca):
    """Check if token was recently bought on any chain. Returns True if should skip."""
    now = int(time.time())
    dedup = _load_shared_dedup()
    entry = dedup.get(ca, {})
    if entry and (now - entry.get('ts', 0)) < SHARED_DEDUP_TTL:
        return True
    return False

def _record_shared_dedup(ca, chain, sym):
    """Record token buy in shared dedup file."""
    now = int(time.time())
    dedup = _load_shared_dedup()
    dedup[ca] = {'ts': now, 'chain': chain, 'sym': sym}
    # Cleanup old entries
    cutoff = now - SHARED_DEDUP_TTL * 2
    dedup = {k: v for k, v in dedup.items() if v.get('ts', 0) > cutoff}
    _save_shared_dedup(dedup)
'''

# ================================================================
# FEATURE 2: Consecutive SL counter
# ================================================================
CONSEC_SL_CONST = """
CONSEC_SL_LIMIT = 3       # consecutive stop losses -> freeze
CONSEC_SL_FREEZE_SEC = 7200  # freeze for 2 hours
"""

CONSEC_SL_CHECK = '''
    # Consecutive SL freeze check
    consec_sl = state.get('consec_sl', 0)
    freeze_until = state.get('consec_sl_freeze_until', 0)
    if freeze_until and now < freeze_until:
        from datetime import datetime
        fu = datetime.fromtimestamp(freeze_until).strftime('%m-%d %H:%M')
        return False, f'consec SL freeze until {fu}'
'''

CONSEC_SL_INCR = """
        # Track consecutive stop losses
        if reason == 'stop_loss':
            state['consec_sl'] = state.get('consec_sl', 0) + 1
            cs = state['consec_sl']
            if cs >= CONSEC_SL_LIMIT:
                state['consec_sl_freeze_until'] = int(time.time()) + CONSEC_SL_FREEZE_SEC
                log(f'CONSEC SL: {cs} losses -> freeze 2h')
            else:
                log(f'CONSEC SL: {cs}/{CONSEC_SL_LIMIT}')
        elif reason not in ('dead_position',):
            # Reset on any non-SL close
            if state.get('consec_sl', 0) > 0:
                log(f'CONSEC SL reset (was {state["consec_sl"]})')
            state['consec_sl'] = 0
            state['consec_sl_freeze_until'] = 0
"""

# ================================================================
# FEATURE 3: soldRatio monitoring
# ================================================================
SOLDRATIO_FUNC = '''
def _check_sold_ratio(chain, ca):
    """Check soldRatio from onchainos API. Returns ratio (0-1) or None on failure."""
    if DRY_RUN and chain == 'solana':
        try:
            r = subprocess.run(
                ['onchainos', 'token', 'price-info', '--address', ca, '--chain', 'solana'],
                capture_output=True, timeout=8, encoding='utf-8', errors='replace'
            )
            if r.returncode == 0 and r.stdout.strip():
                data = json.loads(r.stdout.strip())
                sr = data.get('soldRatio')
                if sr is not None:
                    return float(sr)
        except:
            pass
    return None
'''

# ================================================================
# FEATURE 4: Breakeven at +5%
# ================================================================
# Old TIME_TIERS (we need to find and prepend breakeven tier)
# Pattern to find:
OLD_TIME_TIERS_START = "TIME_TIERS = ["
BREAKEVEN_TIER = """TIME_TIERS = [

    # (hold_hours, SL PnL, TP PnL, sell_pct, label)

    # breakeven: at +5% sell 77% to recover cost (2% risk -> ~2.6% cost overhead)
    (0,   None, 0.05,  0.77, 'breakeven'),

    # (hold_hours, """

NEW_TIME_TIERS_START = """TIME_TIERS = [

    # (hold_hours, SL PnL, TP PnL, sell_pct, label)

    # breakeven: at +5% sell ~77% to recover cost
    (0,   None, 0.05,  0.77, 'breakeven'),

    # (hold_hours, """


def patch_file(filepath, label):
    content = read_file(filepath)
    changes = 0

    # --- Feature 1: Shared dedup constant ---
    if 'SHARED_DEDUP_FILE' not in content:
        # Insert after WALLET_FILE line
        content = content.replace(
            "WALLET_FILE = os.path.join(DATA, 'sm_wallets.json')",
            "WALLET_FILE = os.path.join(DATA, 'sm_wallets.json')\n" + SHARED_DEDUP_CONST.strip() + "\n",
            1  # only first occurrence
        )
        changes += 1
        print(f'  [{label}] +SHARED_DEDUP constant')

    # --- Feature 1: Shared dedup functions ---
    if '_load_shared_dedup' not in content:
        # Insert before def reload_positions_if_external_change
        content = content.replace(
            'def reload_positions_if_external_change(state):',
            SHARED_DEDUP_FUNCS.strip() + '\n\n\n\ndef reload_positions_if_external_change(state):',
            1
        )
        changes += 1
        print(f'  [{label}] +SHARED_DEDUP functions')

    # --- Feature 1: Shared dedup check in buy flow ---
    # Insert after "recently traded (cooldown)" check
    shared_check = """            # Cross-chain dedup
            if _check_shared_dedup(ca):
                log(f'SKIP {sym}: cross-chain dedup (recently bought on other chain)')
                continue

"""
    if '_check_shared_dedup(ca)' not in content:
        content = content.replace(
            "            log(f'SKIP {sym}: recently traded (cooldown)')\n            continue\n\n            if act['buys'] > 0:",
            "            log(f'SKIP {sym}: recently traded (cooldown)')\n            continue\n\n" + shared_check + "            if act['buys'] > 0:",
            1
        )
        changes += 1
        print(f'  [{label}] +SHARED_DEDUP check in buy flow')

    # --- Feature 1: Record shared dedup after buy ---
    shared_record = """                # Record in shared cross-chain dedup
                _record_shared_dedup(ca, chain, sym)

                # Record in trade_history for dedup (cross-cycle protection)"""
    if '_record_shared_dedup(ca, chain, sym)' not in content:
        content = content.replace(
            "                # Record in trade_history for dedup (cross-cycle protection)",
            shared_record,
            1
        )
        changes += 1
        print(f'  [{label}] +SHARED_DEDUP record after buy')

    # --- Feature 2: Consecutive SL constant ---
    if 'CONSEC_SL_LIMIT' not in content:
        content = content.replace(
            "SM_SELL_FOLLOW = 3",
            "SM_SELL_FOLLOW = 3\n" + CONSEC_SL_CONST.strip(),
            1
        )
        changes += 1
        print(f'  [{label}] +CONSEC_SL constant')

    # --- Feature 2: Consecutive SL check in risk limits ---
    if "consec_sl" not in content or "consec_sl_freeze_until" not in content:
        # Insert after monthly pause check
        content = content.replace(
            "        return False, f'monthly pause until {pu}'",
            "        return False, f'monthly pause until {pu}'\n" + CONSEC_SL_CHECK.strip(),
            1
        )
        changes += 1
        print(f'  [{label}] +CONSEC_SL check in risk limits')

    # --- Feature 2: Consecutive SL increment in _save_trade_history ---
    if 'CONSEC_SL_LIMIT' in content and "state['consec_sl']" not in content:
        # Insert after trade_history append + decay, before on_sell_closed block
        content = content.replace(
            "    log(f'trade_history: {sym} closed pnl={exit_pnl_pct:+.1%} hold={hold_hours}h reason={reason}')",
            "    log(f'trade_history: {sym} closed pnl={exit_pnl_pct:+.1%} hold={hold_hours}h reason={reason}')\n" + CONSEC_SL_INCR.strip(),
            1
        )
        changes += 1
        print(f'  [{label}] +CONSEC_SL increment in _save_trade_history')

    # --- Feature 3: soldRatio function ---
    if '_check_sold_ratio' not in content:
        # Insert before def execute_sell
        content = content.replace(
            "def execute_sell(chain, token_ca, token_balance):",
            SOLDRATIO_FUNC.strip() + "\n\n\ndef execute_sell(chain, token_ca, token_balance):",
            1
        )
        changes += 1
        print(f'  [{label}] +SOLDRATIO function')

    # --- Feature 3: soldRatio check in buy flow ---
    soldratio_check = """            # soldRatio check (detect holder dumps)
            sr = _check_sold_ratio(chain, ca)
            if sr is not None:
                if sr >= 0.50:
                    log(f'SKIP {sym}: soldRatio={sr:.0%} (holder dump)')
                    continue
                elif sr >= 0.30:
                    log(f'WARN {sym}: soldRatio={sr:.0%} (penalty: +1 consensus)')
                    # Require one extra good wallet
                    good_buyers_needed = MIN_CONSENSUS_WALLETS + 1
                    if good_buyers < good_buyers_needed:
                        log(f'SKIP {sym}: soldRatio penalty (good={good_buyers}, need>={good_buyers_needed})')
                        continue

"""
    if '_check_sold_ratio(chain, ca)' not in content:
        # Insert before "entry_price = get_token_price_usd"
        content = content.replace(
            "            # get entry price\n            entry_price = get_token_price_usd(chain, ca)",
            soldratio_check + "            # get entry price\n            entry_price = get_token_price_usd(chain, ca)",
            1
        )
        changes += 1
        print(f'  [{label}] +SOLDRATIO check in buy flow')

    # --- Feature 4: Breakeven tier ---
    # Find TIME_TIERS and prepend breakeven
    if "breakeven" not in content and "TIME_TIERS" in content:
        # Find the TIME_TIERS = [ block
        content = content.replace(
            "TIME_TIERS = [\n\n\n    # (hold_hours, ? PnL, , )\n\n\n    (6,",
            "TIME_TIERS = [\n\n\n    # (hold_hours, SL PnL, TP PnL, sell_pct, label)\n\n\n    # breakeven: at +5% sell ~77% to recover cost\n    (0,   None, 0.05,  0.77, 'breakeven'),\n\n\n    (6,",
            1
        )
        changes += 1
        print(f'  [{label}] +BREAKEVEN tier in TIME_TIERS')

    if changes > 0:
        backup(filepath)
        write_file(filepath, content)
        print(f'  [{label}] wrote {changes} changes')
    else:
        print(f'  [{label}] no changes needed')

    return changes


def main():
    print('=== Feature Patch: dedup + consec SL + soldRatio + breakeven ===\n')

    for fp, label in [(SIM, 'sim'), (MON, 'monitor')]:
        if os.path.exists(fp):
            patch_file(fp, label)
        else:
            print(f'  [{label}] NOT FOUND')

    print('\n=== Compile check ===')
    for fp, label in [(SIM, 'sim'), (MON, 'monitor')]:
        if os.path.exists(fp):
            try:
                py_compile.compile(fp, doraise=True)
                print(f'  [OK] {label}')
            except py_compile.PyCompileError as e:
                print(f'  [FAIL] {label}: {e}')


if __name__ == '__main__':
    main()
